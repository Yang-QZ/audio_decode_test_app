<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="@dimen/screen_padding"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/detail_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/on_background"
        android:textSize="@dimen/text_title_large"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detail_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/primary"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/detail_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/text_body" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_spacing"
        android:text="@string/detail_engines_title"
        android:textColor="@color/on_background"
        android:textSize="@dimen/text_title_medium"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/detail_engines_subtitle"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/text_body_small" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_engines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/detail_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/surface_variant"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="20dp"
        android:text="@string/detail_no_engine"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />
</LinearLayout>
