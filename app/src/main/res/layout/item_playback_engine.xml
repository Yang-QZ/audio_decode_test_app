<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/card_margin"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardElevation="0dp"
    app:rippleColor="@color/primary_container"
    app:strokeColor="@color/surface_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/engine_index"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@color/primary_container"
            android:gravity="center"
            android:textColor="@color/on_primary_container"
            android:textSize="@dimen/text_title_small"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/engine_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/text_title_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/engine_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/text_body_small" />
        </LinearLayout>

        <TextView
            android:id="@+id/engine_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/detail_action_enter"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_body_small"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
